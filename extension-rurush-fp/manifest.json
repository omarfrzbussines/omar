{
  "manifest_version": 3,
  "name": "Rurush FP — WhatsApp Free Pass",
  "version": "2.2.2",
  "description": "Recordatorios y reagendos automáticos de WhatsApp para los Free Pass. Lee Pipedrive, envía por WhatsApp Web. Sin uso de Claude.",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "tabs",
    "notifications",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://api.pipedrive.com/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rurush FP"
  },
  "options_page": "options.html"
}
