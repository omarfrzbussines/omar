{
  "manifest_version": 3,
  "name": "Rurush Difusiones",
  "version": "1.0.0",
  "description": "Envía las tandas de difusión desde el Sheet DIFUSIONES por WhatsApp Web, sin repetir números, y marca el Sheet. Sin uso de Claude.",
  "permissions": ["alarms", "storage", "tabs", "notifications"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Rurush Difusiones" },
  "options_page": "options.html"
}
