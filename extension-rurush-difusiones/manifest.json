{
  "manifest_version": 3,
  "name": "Rurush Difusiones",
  "version": "1.5.2",
  "description": "Envía las tandas de difusión desde el Sheet DIFUSIONES por WhatsApp Web, sin repetir números, y marca el Sheet. Modo automático diario por línea. Manda el cuadro de ventas lun-vie 7 am y 9 pm. Publica como estado de WhatsApp las historias programadas. Sin uso de Claude.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://lh3.googleusercontent.com/*",
    "https://drive.usercontent.google.com/*",
    "https://drive.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rurush Difusiones"
  },
  "options_page": "options.html"
}
